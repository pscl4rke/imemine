#!/usr/bin/python3


import logging
LOG = logging.getLogger("localimg")

import argparse
import hashlib
import os
import re
import subprocess
import sys
import time
from urllib.parse import urlparse


SRC_ATTRIBUTE = re.compile(r'src=["\']([^"\']*)["\']')


def name_for_url(url: str) -> str:
    mainpart = hashlib.sha1(url.encode()).hexdigest()
    filename = os.path.basename(urlparse(url).path)
    if "." in filename:
        extension = filename.split(".")[-1]
        return mainpart + "." + extension
    else:
        return mainpart


def ensure(args: argparse.Namespace, url: str) -> str:
    destfile = os.path.join(args.imagedir, name_for_url(url))
    if os.path.exists(destfile):
        LOG.info("At %s I already have %s", destfile, url)
        return destfile
    time.sleep(2)
    LOG.info("Downloading %s...", url)
    #dlargs = ["wget", url, "-O", destfile]
    dlargs = ["curl", url, "-o", destfile]
    subprocess.run(dlargs, check=True)
    LOG.info("Downloaded %s", destfile)
    return destfile


def parse_args(args: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("srcpath")
    parser.add_argument("destpath")
    parser.add_argument("imagedir")
    return parser.parse_args(args)


def main() -> None:
    args = parse_args(sys.argv[1:])
    if not os.path.isdir(args.imagedir):
        raise NotADirectoryError(args.imagedir)
    with open(args.srcpath) as srcfile:
        src = srcfile.read()
    dest = src
    for matched in SRC_ATTRIBUTE.finditer(src):
        created = ensure(args, matched.group(1))
        dest = dest.replace(matched.group(0), f'src="{created}"')
    with open(args.destpath, "w") as destfile:
        destfile.write(dest)


if __name__ == "__main__":
    logging.basicConfig(level=logging.DEBUG)
    main()
